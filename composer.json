{
    "name": "ki5an/tailwind-shades",
    "description": "A PHP color library for creating Tailwind-style color palettes from a single HEX color.",
    "keywords": [
        "tailwind-colors",
        "shades",
        "colors",
        "color-palette",
        "color-generator"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Ki5an\\TailwindShades\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ki5an\\TailwindShades\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "build": "php bin/build.php"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
